# Yosys synthesis script for LUT2 mapping
# add your verilog files here like this: 
# read_verilog <verilog_file1.v>
# read_verilog <verilog_file2.v>

read_verilog Adder.v
read_verilog controller.v
read_verilog controller2.v
read_verilog counter.v
read_verilog datapath.v
read_verilog datapath2.v
read_verilog functions.v
read_verilog HashGen(Top).v
read_verilog M_file.v
read_verilog mux2.v
read_verilog mux4.v
read_verilog register.v
read_verilog rnd_generator(Top).v
read_verilog shiftRegister.v

hierarchy -check -top HashGenerator
synth -lut 2
write_verilog -norename -noattr -noexpr -nodec mapped_design.v